@startuml
'https://plantuml.com/class-diagram


abstract class AbstractEnemy
{
    # droppablePropTypes: String[]
    + dropProp(): BaseProp
}

class PropFactory
{
    + {static} creatProp(type: String, locationX: double, locationY: double, speedX: double, speedY: double): BaseProp
}

abstract class BaseProp
{
    + BaseProp(double locationX, double locationY, double speedX, double speedY)
    + forward(): void
    + activate(): void
}

class BloodProp
{
    + BloodProp(double locationX, double locationY, double speedX, double speedY)
    + activate(): void
}

class BulletProp
{
    + BulletProp(double locationX, double locationY, double speedX, double speedY)
    + activate(): void
}

class BulletPlusProp
{
    + BulletPlusProp(double locationX, double locationY, double speedX, double speedY)
    + activate(): void
}

class BombProp
{
    + BombProp(double locationX, double locationY, double speedX, double speedY)
    + activate(): void
}

class FreezeProp
{
    + FreezeProp(double locationX, double locationY, double speedX, double speedY)
    + activate(): void
}

BaseProp <|-- BloodProp
BaseProp <|-- BulletProp
BaseProp <|-- BulletPlusProp
BaseProp <|-- BombProp
BaseProp <|-- FreezeProp

AbstractEnemy o--> PropFactory
PropFactory ..> BloodProp
PropFactory ..> BulletProp
PropFactory ..> BulletPlusProp
PropFactory ..> BombProp
PropFactory ..> FreezeProp

@enduml
