@startuml
'https://plantuml.com/class-diagram


abstract class AbstractAircraft
{
    # direction: int
    # shootNum: int
    # power: int
    # shootStrategy: ShootStrategy
    + setShootStrategy(strategy: ShootStrategy): void
    + {abstract} shoot(): List<BaseBullet>
}

interface ShootStrategy
{
    + shoot(shooter: AbstractAircraft, bulletType: String): List<BaseBullet>
}

class StraightShootStrategy
{
    + shoot(shooter: AbstractAircraft, bulletType: String): List<BaseBullet>
}

class FanShootStrategy
{
    - {static} OFFSETS_X: double[]
    - {static} SPEEDS_X: double[]
    + shoot(shooter: AbstractAircraft, bulletType: String): List<BaseBullet>
}

class CircleShootStrategy
{
    - BULLET_SPEED: double
    + shoot(shooter: AbstractAircraft, bulletType: String): List<BaseBullet>
}



ShootStrategy <|.. StraightShootStrategy
ShootStrategy <|.. FanShootStrategy
ShootStrategy <|.. CircleShootStrategy

AbstractAircraft o--> ShootStrategy



@enduml
